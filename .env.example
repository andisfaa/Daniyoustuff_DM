# ── Variabel Environment DaniyouStuff ──
# Copy file ini menjadi .env dan isi nilainya
# JANGAN upload file .env ke GitHub!

# Django
SECRET_KEY=daniyoustuff-django-secret-ganti-ini-di-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database MySQL (lokal)
DB_NAME=db_daniyoustuff
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

